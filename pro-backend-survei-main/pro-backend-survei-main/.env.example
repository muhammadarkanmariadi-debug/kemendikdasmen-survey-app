# ==============================================================================
# SISTEM SURVEI KEMENDIKBUDRISTEK - ENVIRONMENT VARIABLES
# ==============================================================================

# PILIHAN PROVIDER DATABASE (mysql | postgresql | sqlite | sqlserver)
# Jika dikosongkan, sistem otomatis mendeteksi provider dari skema DATABASE_URL
DB_PROVIDER=mysql

# CONTOH KONEKSI DATABASE SESUAI PROVIDER:
# 1. MySQL:
DATABASE_URL="mysql://root:password@localhost:3306/apel_cabdin"

# 2. PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/apel_cabdin?schema=public"

# 3. SQLite:
# DATABASE_URL="file:./dev.db"

# 4. SQL Server:
# DATABASE_URL="sqlserver://localhost:1433;database=apel_cabdin;user=sa;password=pass;encrypt=true"

# Keamanan & JWT Token
JWT_SECRET=fef7390d372e5df7ad14b2d59b8ce26a08c1f5b4
JWT_EXPIRATION=1d

# Port Server Backend
PORT=4800

# Kredensial Otentikasi Dasar
BASIC_AUTH_USERNAME=mokletMalang
BASIC_AUTH_PASSWORD=telkomHebat2023
